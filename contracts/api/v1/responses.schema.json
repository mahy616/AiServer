{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "error": {
      "type": "object",
      "required": [
        "code",
        "message",
        "retryable",
        "details"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        },
        "details": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "errorResponse": {
      "type": "object",
      "required": [
        "error",
        "traceId"
      ],
      "properties": {
        "error": {
          "$ref": "#/$defs/error"
        },
        "traceId": {
          "type": "string",
          "format": "uuid"
        }
      },
      "additionalProperties": false
    },
    "accepted": {
      "type": "object",
      "required": [
        "jobId",
        "clientRequestId",
        "model"
      ],
      "properties": {
        "jobId": {
          "type": "string",
          "format": "uuid"
        },
        "clientRequestId": {
          "type": "string",
          "format": "uuid"
        },
        "model": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "ready": {
      "type": "object",
      "required": [
        "canAcceptJobs",
        "schedulerState",
        "inferenceProvider",
        "acceptedInputTypes",
        "reasonCode",
        "observedAt",
        "recommendedPollSeconds",
        "capacityMethod",
        "storage"
      ],
      "properties": {
        "canAcceptJobs": {
          "type": "boolean"
        },
        "schedulerState": {
          "enum": [
            "starting",
            "available",
            "busy",
            "draining",
            "recovering",
            "paused",
            "stopping"
          ]
        },
        "inferenceProvider": {
          "type": "string"
        },
        "acceptedInputTypes": {
          "type": "array",
          "items": {
            "enum": [
              "text",
              "image"
            ]
          }
        },
        "reasonCode": {
          "type": [
            "string",
            "null"
          ]
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        },
        "recommendedPollSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "capacityMethod": {
          "type": "string"
        },
        "storage": {
          "enum": [
            "ok",
            "unavailable"
          ]
        }
      },
      "additionalProperties": false
    },
    "status": {
      "type": "object",
      "required": [
        "jobId",
        "clientRequestId",
        "status",
        "queue",
        "timing",
        "schedulerState",
        "resultAvailable",
        "error",
        "createdAt",
        "startedAt",
        "finishedAt",
        "payloadExpiresAt",
        "pollAfterSeconds",
        "stopReason",
        "inferenceStopConfirmed"
      ],
      "properties": {
        "jobId": {
          "type": "string",
          "format": "uuid"
        },
        "clientRequestId": {
          "type": "string",
          "format": "uuid"
        },
        "status": {
          "enum": [
            "queued",
            "running",
            "cancelling",
            "succeeded",
            "failed",
            "cancelled"
          ]
        },
        "queue": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "waitingAhead",
                "activeAhead",
                "position",
                "isPaused"
              ],
              "properties": {
                "waitingAhead": {
                  "type": "integer",
                  "minimum": 0
                },
                "activeAhead": {
                  "type": "integer",
                  "minimum": 0
                },
                "position": {
                  "type": "integer",
                  "minimum": 0
                },
                "isPaused": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "timing": {
          "type": "object",
          "required": [
            "queueMs",
            "executionMs"
          ],
          "properties": {
            "queueMs": {
              "type": "integer",
              "minimum": 0
            },
            "executionMs": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "schedulerState": {
          "enum": [
            "starting",
            "available",
            "busy",
            "draining",
            "recovering",
            "paused",
            "stopping"
          ]
        },
        "resultAvailable": {
          "type": "boolean"
        },
        "error": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/error"
            }
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "startedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "finishedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "payloadExpiresAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "pollAfterSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "stopReason": {
          "type": [
            "string",
            "null"
          ]
        },
        "inferenceStopConfirmed": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "generation": {
      "type": "object",
      "required": [
        "inputTokens",
        "outputTokens",
        "finishReason",
        "profileId",
        "messageMappingVersion",
        "inferenceProvider",
        "estimatedInputTokens",
        "capacityMethod"
      ],
      "properties": {
        "inputTokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "outputTokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "finishReason": {
          "type": [
            "string",
            "null"
          ]
        },
        "profileId": {
          "type": "string"
        },
        "messageMappingVersion": {
          "type": "string"
        },
        "inferenceProvider": {
          "type": "string"
        },
        "estimatedInputTokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "capacityMethod": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "required": [
        "jobId",
        "clientRequestId",
        "model",
        "status",
        "output",
        "generation",
        "stopReason",
        "inferenceStopConfirmed",
        "error",
        "payloadExpiresAt"
      ],
      "properties": {
        "jobId": {
          "type": "string",
          "format": "uuid"
        },
        "clientRequestId": {
          "type": "string",
          "format": "uuid"
        },
        "model": {
          "type": "string"
        },
        "status": {
          "enum": [
            "queued",
            "running",
            "cancelling",
            "succeeded",
            "failed",
            "cancelled"
          ]
        },
        "output": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "text",
                "isComplete"
              ],
              "properties": {
                "text": {
                  "type": "string"
                },
                "isComplete": {
                  "type": "boolean"
                },
                "reasoningText": {
                  "type": "string"
                },
                "toolCalls": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "id",
                      "type",
                      "function"
                    ],
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "type": {
                        "const": "function"
                      },
                      "index": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "function": {
                        "type": "object",
                        "required": [
                          "name",
                          "arguments"
                        ],
                        "properties": {
                          "name": {
                            "type": "string"
                          },
                          "arguments": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "generation": {
          "$ref": "#/$defs/generation"
        },
        "stopReason": {
          "type": [
            "string",
            "null"
          ]
        },
        "inferenceStopConfirmed": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "error": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/error"
            }
          ]
        },
        "payloadExpiresAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "cancel": {
      "type": "object",
      "required": [
        "jobId",
        "status",
        "cancelAccepted",
        "inferenceStopConfirmed",
        "schedulerState"
      ],
      "properties": {
        "jobId": {
          "type": "string",
          "format": "uuid"
        },
        "status": {
          "enum": [
            "queued",
            "running",
            "cancelling",
            "succeeded",
            "failed",
            "cancelled"
          ]
        },
        "cancelAccepted": {
          "type": "boolean"
        },
        "inferenceStopConfirmed": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "schedulerState": {
          "enum": [
            "starting",
            "available",
            "busy",
            "draining",
            "recovering",
            "paused",
            "stopping"
          ]
        }
      },
      "additionalProperties": false
    },
    "list": {
      "type": "object",
      "required": [
        "items",
        "nextBeforeSequence"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "sequence",
              "jobId",
              "clientRequestId",
              "status",
              "createdAt",
              "finishedAt",
              "errorCode",
              "resultAvailable"
            ],
            "properties": {
              "sequence": {
                "type": "integer",
                "minimum": 0
              },
              "jobId": {
                "type": "string",
                "format": "uuid"
              },
              "clientRequestId": {
                "type": "string",
                "format": "uuid"
              },
              "status": {
                "enum": [
                  "queued",
                  "running",
                  "cancelling",
                  "succeeded",
                  "failed",
                  "cancelled"
                ]
              },
              "createdAt": {
                "type": "string",
                "format": "date-time"
              },
              "finishedAt": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              },
              "errorCode": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "resultAvailable": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        },
        "nextBeforeSequence": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "models": {
      "type": "object",
      "required": [
        "models"
      ],
      "properties": {
        "models": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "inputTypes",
              "outputTypes",
              "limits",
              "capacityMethod",
              "generationParameters"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "inputTypes": {
                "type": "array",
                "items": {
                  "enum": [
                    "text",
                    "image"
                  ]
                }
              },
              "outputTypes": {
                "const": [
                  "text"
                ]
              },
              "limits": {
                "type": "object",
                "required": [
                  "maxRequestBytes",
                  "maxTextUtf8Bytes",
                  "maxMessages",
                  "maxImages",
                  "imageMediaTypes",
                  "maxImageBytes",
                  "maxImageLongEdge",
                  "maxImagePixels",
                  "contextTokens",
                  "maxInputTokens",
                  "maxOutputTokens",
                  "defaultMaxInputTokens",
                  "reservedTokens",
                  "inputBudgetPolicy"
                ],
                "properties": {
                  "maxRequestBytes": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "maxTextUtf8Bytes": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "maxMessages": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "maxImages": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "imageMediaTypes": {
                    "type": "array",
                    "items": {
                      "enum": [
                        "image/png",
                        "image/jpeg"
                      ]
                    },
                    "uniqueItems": true
                  },
                  "maxImageBytes": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "maxImageLongEdge": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "maxImagePixels": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "contextTokens": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "maxInputTokens": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0,
                    "description": "Maximum input with one output token; each request must satisfy contextTokens minus its effective output budget minus reservedTokens."
                  },
                  "maxOutputTokens": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "defaultMaxInputTokens": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0,
                    "description": "Input limit with the server default/max output budget."
                  },
                  "reservedTokens": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "inputBudgetPolicy": {
                    "enum": [
                      "window-minus-output-v1",
                      "provider-defined"
                    ]
                  }
                },
                "additionalProperties": false
              },
              "capacityMethod": {
                "type": "string"
              },
              "generationParameters": {
                "const": "request-or-model-default"
              },
              "toolCall": {
                "type": "boolean",
                "description": "Whether the running provider verified native function calling for this model."
              },
              "outputChannels": {
                "type": "array",
                "items": {
                  "enum": [
                    "content",
                    "reasoning_content",
                    "tool_calls"
                  ]
                }
              },
              "roleMappings": {
                "type": "object",
                "properties": {
                  "developer": {
                    "const": "system"
                  }
                },
                "additionalProperties": false
              },
              "outputLimitPolicy": {
                "const": "reject-above-limit"
              },
              "thinking": {
                "type": "boolean",
                "description": "Engine-verified native thinking capability, not the enabled mode. Thinking defaults off and requires request think=true; unsupported models ignore the flag."
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "authUser": {
      "type": "object",
      "required": [
        "userId",
        "displayName"
      ],
      "properties": {
        "userId": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "me": {
      "type": "object",
      "required": [
        "user",
        "expiresAt"
      ],
      "properties": {
        "user": {
          "$ref": "#/$defs/authUser"
        },
        "expiresAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "additionalProperties": false
    }
  }
}

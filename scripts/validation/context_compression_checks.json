{
  "C#脚本示例.txt": [
    {"id": "namespace", "pattern": "namespace\\s+NamespaceCsharpScriptEngine"},
    {"id": "class", "pattern": "public\\s+class\\s+CsharpScriptClass"},
    {"id": "entry", "pattern": "public\\s+static\\s+void\\s+Execute\\s*\\(Guid\\s+processkey\\)"},
    {"id": "constructor", "pattern": "new\\s+Script_Function\\s*\\(processkey\\)"},
    {"id": "global-gap-up", "pattern": "Script\\.GetGlobalVarValue\\(\"gap上限\"\\)"},
    {"id": "global-gap-down", "pattern": "Script\\.GetGlobalVarValue\\(\"gap下限\"\\)"},
    {"id": "local-index", "pattern": "Script\\.GetVarValue\\(2,\\s*\"index\"\\)"},
    {"id": "tool-gap", "pattern": "Script\\.GetValue\\(67,\\s*\"Distance\"\\)"},
    {"id": "gap-boundary", "pattern": "gap\\s*<\\s*gap_threshold_down\\s*\\|\\|\\s*gap\\s*>\\s*gap_threshold_up"},
    {"id": "top-b-compensation", "pattern": "Math\\.Abs\\(top_location\\s*-\\s*actualValues\\[70-index\\]\\)\\+compensation_B_threshold"},
    {"id": "bottom-a-compensation", "pattern": "Math\\.Abs\\(bottom_location\\s*-\\s*actualValues\\[70-index\\]\\)\\+compensation_A_threshold"},
    {"id": "pin-first-loop", "pattern": "int\\s+i\\s*=\\s*1;\\s*i\\s*<=\\s*28;\\s*i\\+\\+"},
    {"id": "pin-second-loop", "pattern": "int\\s+i\\s*=\\s*29;\\s*i\\s*<=\\s*42;\\s*i\\+\\+"},
    {"id": "pin-third-loop", "pattern": "int\\s+i\\s*=\\s*43;\\s*i\\s*<=\\s*70;\\s*i\\+\\+"},
    {"id": "pin-first-formula", "pattern": "14\\.715\\s*\\+\\s*\\(28\\s*-\\s*i\\)\\s*\\*\\s*0\\.6"},
    {"id": "pin-second-formula", "pattern": "2\\.005\\s*\\+\\s*\\(42\\s*-\\s*i\\)\\s*\\*\\s*0\\.6"},
    {"id": "point-type-and-port", "pattern": "List<Point2D>.*?Script\\.GetValue\\(51,\\s*\"point2ds\"\\)"},
    {"id": "local-pin-data", "pattern": "Script\\.GetVarValue\\(2,\\s*\"Bpin针数据\"\\)"},
    {"id": "failure-front-result", "pattern": "Script\\.SetVarValue\\(2,\\s*\"front_result\",\\s*false\\)"}
  ],
  "C#脚本示例2.txt": [
    {"id": "entry", "pattern": "public\\s+static\\s+void\\s+Execute\\s*\\(Guid\\s+processkey\\)"},
    {"id": "constructor", "pattern": "new\\s+Script_Function\\s*\\(processkey\\)"},
    {"id": "xunhuan-do-not-change", "pattern": "xunhuan：沿用外部流程控制，本脚本不修改"},
    {"id": "trigger-new-semantics", "pattern": "trigger已改为分支编号，不再是旧版本的上升沿允许标志"},
    {"id": "external-reset", "pattern": "第四次通知成功后，由外部将photoCount和trigger设为0"},
    {"id": "serial-workflow", "pattern": "各节点串行执行，当前拍照和通知完成前不要再次执行监听"},
    {"id": "trigger-zero", "pattern": "Script\\.SetGlobalVarValue\\(\"trigger\",\\s*0\\.0\\)"},
    {"id": "allowed-counts", "pattern": "count\\s*!=\\s*0\\.0\\s*&&\\s*count\\s*!=\\s*1\\.0\\s*&&\\s*count\\s*!=\\s*2\\.0\\s*&&\\s*count\\s*!=\\s*3\\.0\\s*&&\\s*count\\s*!=\\s*4\\.0"},
    {"id": "fourth-return", "pattern": "if\\s*\\(count\\s*==\\s*4\\.0\\).*?return;"},
    {"id": "signal-index", "pattern": "signalIndex\\s*=\\s*4\\s*\\+\\s*\\(int\\)count\\s*\\*\\s*2"},
    {"id": "receive-length", "pattern": "received\\s*=\\s*new\\s+byte\\[13\\]"},
    {"id": "serial-config", "pattern": "SerialPort\\(\"COM7\",\\s*38400,\\s*Parity\\.None,\\s*8,\\s*StopBits\\.One\\)"},
    {"id": "read-timeout", "pattern": "sp\\.ReadTimeout\\s*=\\s*8000"},
    {"id": "write-timeout", "pattern": "sp\\.WriteTimeout\\s*=\\s*8000"},
    {"id": "request-bytes", "pattern": "0x01,\\s*0x04,\\s*0x00,\\s*0x00,\\s*0x00,\\s*0x04,\\s*0xF1,\\s*0xC9"},
    {"id": "remaining-timeout", "pattern": "remaining\\s*=\\s*8000\\s*-\\s*\\(int\\)timer\\.ElapsedMilliseconds"},
    {"id": "receive-completion", "pattern": "while\\s*\\(offset\\s*<\\s*received\\.Length\\)"},
    {"id": "reply-header", "pattern": "received\\[0\\]\\s*!=\\s*0x01\\s*\\|\\|\\s*received\\[1\\]\\s*!=\\s*0x04\\s*\\|\\|\\s*received\\[2\\]\\s*!=\\s*8"},
    {"id": "accepted-count-increment", "pattern": "count\\s*\\+=\\s*1\\.0"},
    {"id": "photo-count-update", "pattern": "Script\\.SetGlobalVarValue\\(\"photoCount\",\\s*count\\)"},
    {"id": "trigger-count-update", "pattern": "Script\\.SetGlobalVarValue\\(\"trigger\",\\s*count\\)"},
    {"id": "error-state", "pattern": "Script\\.SetGlobalVarValue\\(\"index\",\\s*-1\\.0\\)"}
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Generic inference request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "clientRequestId",
    "model",
    "messages"
  ],
  "properties": {
    "clientRequestId": {
      "type": "string",
      "format": "uuid"
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "think": {
      "description": "Request opt-in: absent/null/false disables thinking; true enables only engine-verified thinking models. Unsupported models ignore this flag. Legacy GenerationDefaults.think does not enable thinking.",
      "default": false,
      "type": [
        "boolean",
        "null"
      ]
    },
    "messages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "content"
        ],
        "properties": {
          "role": {
            "enum": [
              "system",
              "user",
              "assistant"
            ]
          },
          "reasoning_content": {
            "type": "string",
            "maxLength": 2097152
          },
          "content": {
            "type": "array",
            "minItems": 1,
            "maxItems": 256,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type",
                    "text"
                  ],
                  "properties": {
                    "type": {
                      "const": "text"
                    },
                    "text": {
                      "type": "string",
                      "maxLength": 2097152
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type",
                    "mediaType",
                    "dataBase64"
                  ],
                  "properties": {
                    "type": {
                      "const": "image"
                    },
                    "mediaType": {
                      "enum": [
                        "image/png",
                        "image/jpeg"
                      ]
                    },
                    "dataBase64": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4194304
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  },
  "description": "Text, reasoning history and images are preserved. Optional think explicitly opts in on supported models; absent/null defaults off; generation output uses the public resource cap. All text/history/tools share byte and context limits."
}

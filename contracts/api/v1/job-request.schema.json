{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "clientRequestId",
    "operation",
    "instruction",
    "context"
  ],
  "properties": {
    "clientRequestId": {
      "type": "string",
      "format": "uuid"
    },
    "operation": {
      "enum": [
        "create",
        "modify",
        "explain"
      ]
    },
    "instruction": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192,
      "description": "non-whitespace; max 8192 UTF-8 bytes"
    },
    "currentCode": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 65536,
      "description": "Required non-whitespace for modify; max 65536 UTF-8 bytes"
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "targetFramework"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "targetFramework": {
          "const": ".NETFramework,Version=v4.7.2"
        },
        "projectId": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "scriptId": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "snapshotRevision": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "csharpLanguageVersion": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "sdkContractVersion": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "sdkReferenceText": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 32768,
          "description": "Maximum 32768 UTF-8 bytes"
        },
        "flowContextText": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 32768,
          "description": "Maximum 32768 UTF-8 bytes"
        }
      }
    },
    "history": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "content"
        ],
        "properties": {
          "role": {
            "enum": [
              "user",
              "assistant"
            ]
          },
          "content": {
            "type": "string",
            "maxLength": 16384,
            "description": "All history combined <=16384 UTF-8 bytes"
          }
        }
      }
    },
    "images": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "imageId",
          "mediaType",
          "dataBase64"
        ],
        "properties": {
          "imageId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "mediaType": {
            "const": "image/png"
          },
          "dataBase64": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4194304
          },
          "capturedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "snapshotRevision": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 128
          }
        }
      }
    },
    "parentJobId": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    }
  }
}

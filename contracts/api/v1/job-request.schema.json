{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Generic inference request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "clientRequestId",
    "model",
    "messages"
  ],
  "properties": {
    "clientRequestId": {
      "type": "string",
      "format": "uuid"
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "think": {
      "description": "Boolean models default off. Named-level models use their published default for absent/null/true, accept published levels, and reject false. Unsupported named levels return 400.",
      "oneOf": [
        {"type": ["boolean", "null"]},
        {"enum": ["low", "medium", "high"]}
      ]
    },
    "messages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "content"
        ],
        "properties": {
          "role": {
            "enum": [
              "system",
              "user",
              "assistant"
            ]
          },
          "reasoning_content": {
            "type": "string",
            "maxLength": 2097152
          },
          "content": {
            "type": "array",
            "minItems": 1,
            "maxItems": 256,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type",
                    "text"
                  ],
                  "properties": {
                    "type": {
                      "const": "text"
                    },
                    "text": {
                      "type": "string",
                      "maxLength": 2097152
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type",
                    "mediaType",
                    "dataBase64"
                  ],
                  "properties": {
                    "type": {
                      "const": "image"
                    },
                    "mediaType": {
                      "enum": [
                        "image/png",
                        "image/jpeg"
                      ]
                    },
                    "dataBase64": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4194304
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  },
  "description": "Text, reasoning history and images are preserved. Optional think follows the selected model's boolean or named-level policy; generation output uses the public resource cap. All text/history/tools share byte and context limits."
}

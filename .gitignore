# Local runtimes, models, downloads, reports, releases and full local backups.
.local/
/.local.*
.worktrees/

# Private deployment configuration; keep public examples and model metadata.
*.local.json
*.local.ini
/config/inference.development.json
/config/inference.production.json
/config/natapp.ini

# Environment secrets; sanitized example files may be committed.
.env
.env.*
!.env.example
!.env.*.example
!.env.sample
!.env.template
*.token
*.secret
*.dpapi
*.key
*.pem
*.p12
*.pfx

# Existing local tunnel binary and launcher (may contain a tunnel token).
/natapp.exe
/run_natapp.bat

# Runtime databases, journals and rotating logs.
*.db
*.db-shm
*.db-wal
*.db-journal
*.sqlite*
*.log
*.log.*
*.pid

# Python environments, packaging, caches and coverage output.
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Node/OpenCode dependencies and compiled C# benchmark output.
node_modules/
bin/
obj/

# Model weights and compiled inference engines, even outside .local/.
*.gguf
*.safetensors
pytorch_model*.bin
*.pt
*.pth
*.onnx
*.ckpt
*.engine

# Configuration backups and temporary editor files may contain private data.
*.bak
*.backup
*.tmp
*.temp
*.orig
*.rej
*.swp
*.swo
*~
.idea/
.vs/

# Operating-system metadata.
.DS_Store
Thumbs.db
Desktop.ini

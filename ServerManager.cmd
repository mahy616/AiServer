@echo off
setlocal
set "AISERVER_MANAGER_ROOT=%~dp0"
powershell.exe -NoProfile -STA -WindowStyle Hidden -Command "Add-Type -AssemblyName System.Windows.Forms; $root=$env:AISERVER_MANAGER_ROOT; $exe='C:\ProgramData\anaconda3\envs\trt_test_1013\python.exe'; $prefs=Join-Path $root '.local\server-manager\launcher.json'; if(Test-Path -LiteralPath $prefs){try{$saved=Get-Content -Raw -LiteralPath $prefs -Encoding UTF8 | ConvertFrom-Json; if($saved.python){$exe=$saved.python}}catch{}}; if(-not(Test-Path -LiteralPath $exe -PathType Leaf)){$picker=New-Object System.Windows.Forms.OpenFileDialog; $picker.Title='Select server Python 3.12 python.exe'; $picker.Filter='Python executable (python.exe)|python.exe'; if($picker.ShowDialog() -ne [System.Windows.Forms.DialogResult]::OK){exit 0}; $exe=$picker.FileName}; try{$script=Join-Path $root 'scripts\server\ServerManager.py'; $q=[char]34; $child=Start-Process -FilePath $exe -ArgumentList @('-u',($q+$script+$q)) -WorkingDirectory $root -WindowStyle Hidden -PassThru -Wait; if($child.ExitCode -ne 0){[System.Windows.Forms.MessageBox]::Show('Server Manager could not start. Check Python 3.12 with tkinter, or run scripts/server/ServerManager.py in a terminal.','AiServer')}}catch{[System.Windows.Forms.MessageBox]::Show('Cannot start Server Manager. Select the server Python interpreter and verify the copied scripts.','AiServer')}"
endlocal
